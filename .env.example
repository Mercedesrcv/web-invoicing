# --- Claude (cerebro del agente) ---
# Sin clave, la web funciona en "modo demo" con respuestas guionizadas.
ANTHROPIC_API_KEY=
# Modelo por defecto: claude-opus-5-5. Para menor latencia en voz puedes probar claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
# Esfuerzo de razonamiento (low | medium | high). En voz, "low" prioriza latencia.
ANTHROPIC_EFFORT=low

# --- Almacenamiento de la monitorización ---
# Si hay una URL de Postgres (Vercel Postgres/Neon, Supabase...), se usa Postgres.
# Si no, se usa un fichero JSONL (LOG_FILE_PATH) y, en Vercel sin BD, memoria/tmp efímero.
DATABASE_URL=
# STORAGE=postgres | file | memory   (opcional, fuerza un backend)
STORAGE=
LOG_FILE_PATH=.data/events.jsonl

# --- Panel de administración (/admin) ---
# Obligatorio en producción. En local, si está vacío, el panel queda abierto.
ADMIN_TOKEN=

# --- Marca ---
NEXT_PUBLIC_BRAND_NAME=GuestBill
